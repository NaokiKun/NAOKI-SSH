language_menu() {
    clear
    printf '\n%s / %s\n' "$(t SELECT_LANGUAGE)" 'ဘာသာစကားရွေးချယ်ပါ'
    printf '[1] %s\n' "$(t ENGLISH)"
    printf '[2] %s\n' "$(t MYANMAR)"
    printf '[0] %s\n' "$(t EXIT)"
    printf '%s: ' "$(t CHOOSE)"
    local choice
    read -r choice
    case "$choice" in
        1) naoki_lang_save en ;;
        2) naoki_lang_save my ;;
        0) return 0 ;;
        *) printf '%s\n' "$(t INVALID)"; sleep 1; return 1 ;;
    esac
    printf '%s\n' "$(t LANGUAGE_SAVED)"
    sleep 1
}

