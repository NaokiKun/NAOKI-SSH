#!/usr/bin/env bash

# NAOKI SSH bilingual language support.
# Supported languages: en (English) and my (Myanmar).
NAOKI_LANG_FILE="${NAOKI_LANG_FILE:-/etc/naoki-ssh-language}"
NAOKI_LANG="${NAOKI_LANG:-}"

naoki_lang_init() {
    local saved=""
    if [[ -r "$NAOKI_LANG_FILE" ]]; then
        IFS= read -r saved < "$NAOKI_LANG_FILE"
    fi
    if [[ "$saved" == "en" || "$saved" == "my" ]]; then
        NAOKI_LANG="$saved"
    elif [[ "$NAOKI_LANG" != "en" && "$NAOKI_LANG" != "my" ]]; then
        NAOKI_LANG="en"
    fi
    export NAOKI_LANG
}

naoki_lang_save() {
    local selected="$1"
    [[ "$selected" != "en" && "$selected" != "my" ]] && return 1
    NAOKI_LANG="$selected"
    export NAOKI_LANG
    if [[ "$EUID" -eq 0 ]]; then
        printf '%s\n' "$selected" > "$NAOKI_LANG_FILE"
        chmod 644 "$NAOKI_LANG_FILE"
    else
        printf '%s\n' "$selected" > "${HOME}/.naoki-ssh-language"
    fi
}

